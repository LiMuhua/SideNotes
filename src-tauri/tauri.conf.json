{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SideNotes",
  "version": "0.7.3",
  "identifier": "com.limuhua.sidenotes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "create": false,
        "title": "SideNotes",
        "url": "index.html",
        "width": 416,
        "height": 900,
        "minWidth": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "shadow": true,
        "focus": false
      },
      {
        "label": "capture",
        "dragDropEnabled": false,
        "create": false,
        "title": "SideNotes 速记",
        "url": "index.html",
        "width": 560,
        "height": 420,
        "minWidth": 370,
        "minHeight": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "shadow": true,
        "focus": false
      },
      {
        "label": "settings",
        "dragDropEnabled": false,
        "create": false,
        "title": "SideNotes 设置",
        "url": "index.html",
        "width": 880,
        "height": 560,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "shadow": true,
        "focus": true
      },
      {
        "label": "overlay",
        "dragDropEnabled": false,
        "create": false,
        "title": "SideNotes 动画层",
        "url": "index.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "shadow": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/attachments/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/builtin/": "app-icons/"
    },
    "copyright": "© 2026 LiMuhua",
    "category": "Productivity",
    "shortDescription": "本地速记与侧栏取用",
    "longDescription": "SideNotes 是面向 Windows 的本地快速记录工具：鼠标移到屏幕边缘唤出侧栏，也可用快捷键浮窗随手记录。支持 Markdown、标签、图片附件与本地 SQLite 存储。",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}